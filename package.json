{
  "name": "putduk-mining",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PUTDUK MINING production web and PWA foundation",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": "12.6.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:admin": "pnpm --dir apps/admin dev",
    "build": "pnpm build:web && pnpm build:admin",
    "build:web": "next build",
    "build:admin": "pnpm --dir apps/admin build",
    "start": "next start",
    "start:admin": "pnpm --dir apps/admin start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm typecheck:web && pnpm typecheck:admin",
    "typecheck:web": "tsc --noEmit",
    "typecheck:admin": "pnpm --dir apps/admin typecheck",
    "test": "pnpm test:web && pnpm test:admin",
    "test:web": "vitest run",
    "test:admin": "pnpm --dir apps/admin test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:authenticated": "playwright test --config playwright.authenticated.config.ts",
    "test:e2e:auth:smoke": "playwright test --config playwright.authenticated.config.ts --project=chromium tests/e2e/authenticated/public-admin-boundary.spec.ts",
    "test:e2e:auth:admin": "playwright test --config playwright.authenticated.config.ts --project=chromium tests/e2e/authenticated/admin-session-totp.spec.ts",
    "test:e2e:auth:krw": "playwright test --config playwright.authenticated.config.ts --project=chromium tests/e2e/authenticated/first-krw-withdrawal.spec.ts",
    "test:e2e:auth:usdt": "playwright test --config playwright.authenticated.config.ts --project=chromium tests/e2e/authenticated/first-usdt-withdrawal.spec.ts",
    "test:e2e:auth:guards": "playwright test --config playwright.authenticated.config.ts --project=chromium tests/e2e/authenticated/withdrawal-negative-guards.spec.ts",
    "test:e2e:auth:admin-krw": "playwright test --config playwright.authenticated.config.ts --project=chromium tests/e2e/authenticated/admin-krw-browser-money.spec.ts",
    "test:e2e:auth:admin-usdt": "playwright test --config playwright.authenticated.config.ts --project=chromium tests/e2e/authenticated/admin-usdt-browser-money.spec.ts",
    "test:e2e:auth:step-up": "playwright test --config playwright.authenticated.config.ts --project=chromium tests/e2e/authenticated/admin-withdrawal-step-up.spec.ts",
    "test:e2e:auth:visual": "playwright test --config playwright.authenticated.config.ts --project=visual-evidence tests/e2e/authenticated/success-visual-evidence.spec.ts",
    "test:e2e:auth:full": "playwright test --config playwright.authenticated.config.ts",
    "test:e2e:auth:one": "playwright test --config playwright.authenticated.config.ts --project=chromium",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:load": "k6 run tests/load/core-api.k6.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "assets:verify": "node scripts/verify-brand-assets.mjs",
    "db:start": "supabase db start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint --local --schema public,app_private --level warning --fail-on warning",
    "db:advisors": "supabase db advisors --local --type security --level warn --fail-on warn",
    "db:test": "supabase test db",
    "db:verify": "pnpm db:reset && pnpm db:test && pnpm db:lint && pnpm db:advisors",
    "admin:bootstrap": "node --env-file-if-exists=.env.local scripts/bootstrap-first-admin.mjs",
    "verify": "pnpm assets:verify && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "motion": "13.4.4",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "jsdom": "30.1.1",
    "postcss": "8.5.28",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}

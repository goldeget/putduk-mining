# Public app
NEXT_PUBLIC_APP_URL=https://mining.putduk.com
# Dedicated admin build. Server-only; never use this value as authorization.
ADMIN_APP_URL=https://admin.mining.putduk.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Safety check for one-time operator scripts. This is the only allowed project ref.
SUPABASE_PROJECT_REF=osrmyjgmpdspdcwqjwuv

# Server-only 32-byte base64 key for AES-256-GCM withdrawal destination envelopes
WITHDRAWAL_DATA_KEY=

# PWA / Web Push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Channel Talk support. Plugin key is public. Member hash secret is server-only.
# Leave both empty until the Channel Talk account provides them. Never invent values.
NEXT_PUBLIC_CHANNEL_TALK_PLUGIN_KEY=
CHANNEL_TALK_MEMBER_HASH_SECRET=

# Server
APP_ENV=development
APP_TIMEZONE=UTC

# AI
AI_PROVIDER=
AI_API_KEY=
AI_MODEL_LOW_COST=
AI_MODEL_HIGH_CAPABILITY=
AI_MAX_OUTPUT_TOKENS=900
AI_MAX_REQUESTS_PER_MINUTE=5
AI_MAX_REQUESTS_PER_DAY=100
AI_CACHE_TTL_SECONDS=3600

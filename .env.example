# Public app
NEXT_PUBLIC_APP_URL=https://mining.putduk.com
# Dedicated admin build. Server-only; never use this value as authorization.
ADMIN_APP_URL=https://admin.mining.putduk.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Safety check for one-time operator scripts. This is the only allowed project ref.
SUPABASE_PROJECT_REF=osrmyjgmpdspdcwqjwuv

# Server-only 32-byte base64 key for AES-256-GCM withdrawal destination envelopes
WITHDRAWAL_DATA_KEY=

# PWA / Web Push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Channel Talk support. Plugin key is public. Member hash secret is server-only.
# Leave both empty until the Channel Talk account provides them. Never invent values.
NEXT_PUBLIC_CHANNEL_TALK_PLUGIN_KEY=
CHANNEL_TALK_MEMBER_HASH_SECRET=

# KRW manual deposit account shown to members (public instruction, not a secret).
# Set all three or none. Leave empty until the operator decides the account. Never invent values.
KRW_DEPOSIT_BANK_NAME=
KRW_DEPOSIT_ACCOUNT_NUMBER=
KRW_DEPOSIT_ACCOUNT_HOLDER=

# Server
APP_ENV=development
APP_TIMEZONE=UTC

# Optional public release token. Letters, numbers, dot, underscore, hyphen. Never a secret.
# NEXT_PUBLIC_APP_RELEASE=

# AI (cascade: NVIDIA trial → OpenRouter free → Haiku paid last)
# Non-production only: set APP_ENV to development|staging|test (never production for dispatch).
# Owner switch for real provider calls. OFF by default everywhere. A key alone never
# dispatches. Only the exact value "true" enables non-prod dispatch. Production stays
# code-blocked even if this is "true" — that enable is a separate human gate.
# Example non-prod admit: AI_PROVIDER_DISPATCH_ENABLED=true with NVIDIA key+model below.
AI_PROVIDER_DISPATCH_ENABLED=
AI_PROVIDER=nvidia
AI_API_KEY=
AI_MODEL_LOW_COST=openai/gpt-oss-20b
AI_MODEL_HIGH_CAPABILITY=
# Separate free-tier key; missing free key does NOT jump to paid Haiku.
OPENROUTER_FREE_API_KEY=
# Paid OpenRouter key may be present for future owner-gated Haiku; route keeps
# paidCallAuthorized=false until explicit owner approval + reviewed code change.
OPENROUTER_API_KEY=
AI_MAX_OUTPUT_TOKENS=900
AI_MAX_REQUESTS_PER_MINUTE=5
AI_MAX_REQUESTS_PER_DAY=100
AI_CACHE_TTL_SECONDS=3600
AI_FIRST_TOKEN_TIMEOUT_MS=2000
